# This is the SSH daemon configuration generated by Ansible
# fedora_minimal role for Fedora 43+ systems
# CIS Fedora Linux Benchmark alignment
#
# Do not modify manually; changes will be overwritten by Ansible
#
# Generated: {{ ansible_date_time.iso8601 }}

# ============================================================================
# Network and Protocol
# ============================================================================

# Port to listen on (CIS 5.2.1)
Port {{ fedora_minimal_ssh_port }}

# Protocol version - SSH2 only (CIS 5.2.6)
Protocol {{ fedora_minimal_ssh_protocol }}

# Listening addresses
ListenAddress 0.0.0.0
ListenAddress ::

# AddressFamily
AddressFamily any

# ============================================================================
# Host Keys
# ============================================================================

# HostKeys for protocol version 2
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

# ============================================================================
# Authentication
# ============================================================================

# Root login disabled (CIS 5.2.2)
PermitRootLogin {% if fedora_minimal_ssh_permit_root_login %}yes{% else %}no{% endif %}

# Disable password authentication - use keys only (CIS 5.2.4)
PasswordAuthentication {% if fedora_minimal_ssh_password_authentication %}yes{% else %}no{% endif %}

# Disable challenge-response authentication for password auth
ChallengeResponseAuthentication no

# Disable GSS authentication
GSSAPIAuthentication no

# User/group restrictions
AllowUsers *@*
AllowGroups ssh-users wheel

# ============================================================================
# Session Configuration
# ============================================================================

# Maximum client aliveness checks
ClientAliveInterval 300
ClientAliveCountMax 2

# Permit user environment specifications
PermitUserEnvironment no

# ============================================================================
# X11 and Agent Forwarding
# ============================================================================

# Disable X11 forwarding
X11Forwarding no

# Disable agent forwarding
AllowAgentForwarding no

# Disable TCP forwarding
AllowTcpForwarding no

# ============================================================================
# Logging
# ============================================================================

# Facility and verbosity
SyslogFacility AUTH
LogLevel VERBOSE

# ============================================================================
# Miscellaneous
# ============================================================================

# Disable empty passwords
PermitEmptyPasswords no

# Disable user/password authentication
UsePAM yes

# Print message of the day
PrintMotd no

# Print last login information
PrintLastLog yes

# Compress connection data
Compression delayed

# ============================================================================
# Subsystem Configuration
# ============================================================================

Subsystem sftp /usr/lib/openssh/sftp-server

# ============================================================================
# Additional Security Settings
# ============================================================================

# Disable insecure authentication methods
PubkeyAuthentication yes
KerberosAuthentication no
HostbasedAuthentication no
RhostsRSAAuthentication no
RSAAuthentication no

# Set max auth tries
MaxAuthTries 4

# Set max sessions
MaxSessions 10

# Message authentication code algorithms
MACs umac-64-etm@openssh.com,umac-128-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512-etm@openssh.com

# Key exchange algorithms
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group-exchange-sha256

# Ciphers
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr

# ============================================================================
# End of SSH daemon configuration
# ============================================================================
